# Copy to .env.local (gitignored) and fill in from your Supabase project's
# Settings → API page.
NEXT_PUBLIC_SUPABASE_URL=
# Newer Supabase projects call this the "Publishable key"; older ones call it the "anon key"
# (NEXT_PUBLIC_SUPABASE_ANON_KEY also works). Either is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sends the "you created/joined a trip" confirmation emails via Gmail SMTP.
# GMAIL_USER is the Gmail address to send from. GMAIL_APP_PASSWORD is a 16-character
# App Password (Google Account → Security → 2-Step Verification → App passwords) —
# not your regular Gmail password. Server-only: never expose these as NEXT_PUBLIC_.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: defaults to "TripSplit <GMAIL_USER>".
GMAIL_FROM_EMAIL=
