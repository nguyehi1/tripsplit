# Copy to .env.local (gitignored) and fill in from your Supabase project's
# Settings → API page.
NEXT_PUBLIC_SUPABASE_URL=
# Newer Supabase projects call this the "Publishable key"; older ones call it the "anon key"
# (NEXT_PUBLIC_SUPABASE_ANON_KEY also works). Either is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sends the "you created/joined a trip" confirmation emails. From resend.com/api-keys.
# Without a verified sending domain, Resend only delivers to the email you signed up with —
# fine for local testing, not for real users. Server-only: never expose this as NEXT_PUBLIC_.
RESEND_API_KEY=
# Must be on a domain verified in Resend once you're sending to real users. Defaults to
# Resend's shared sandbox address, which only works with the restriction above.
RESEND_FROM_EMAIL="TripSplit <onboarding@resend.dev>"
