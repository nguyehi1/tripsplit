# Copy to .env.local (gitignored) and fill in from your Supabase project's
# Settings → API page.
NEXT_PUBLIC_SUPABASE_URL=
# Newer Supabase projects call this the "Publishable key"; older ones call it the "anon key"
# (NEXT_PUBLIC_SUPABASE_ANON_KEY also works). Either is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sends the "you created/joined a trip" confirmation emails via Resend.
# Get an API key from https://resend.com/api-keys once your sending domain is verified.
# Server-only: never expose this as NEXT_PUBLIC_.
RESEND_API_KEY=
# Optional: defaults to "Splitiful <noreply@splitiful.app>".
RESEND_FROM_EMAIL=

# Rate limits the invite-code lookup/join endpoints (src/lib/rate-limit.ts) against a free
# Upstash Redis database — create one at https://console.upstash.com and copy its REST URL/token.
# Server-only: never expose these as NEXT_PUBLIC_. In a production build (NODE_ENV=production),
# leaving these unset makes the rate-limited routes fail closed with a 503 rather than silently
# running unthrottled — see src/lib/rate-limit.ts for why. Outside production they're optional;
# rate limiting is just skipped with a console warning.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
