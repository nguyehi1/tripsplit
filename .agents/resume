#!/usr/bin/env bash
# Amp orb resume — runs on every orb wake, before Amp continues.
# Keep it fast (Amp waits at most 10s), idempotent, and free of dependency installs.
# Nothing here authenticates a service (Supabase/Resend/Upstash keys come from .env.local),
# so this only sanity-checks the environment and repairs the local env template.
set -euo pipefail

if [[ ! -f .env.local ]]; then
  cp -- .env.local.example .env.local
fi

# Sanity only — never install in resume.
node -v >/dev/null
[[ -d node_modules ]] || echo "[resume] WARNING: node_modules missing; run .agents/setup"

exit 0
