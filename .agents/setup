#!/usr/bin/env bash
# Amp orb setup — see https://ampcode.com/docs/orbs.
# Runs once for a fresh orb (before snapshotting). Must be non-interactive, idempotent,
# and fast on a warm filesystem (files restored from a snapshot).
set -euo pipefail

step_start=$(date +%s)
step() {
  local now
  now=$(date +%s)
  echo "[setup] +$((now - step_start))s $*"
}

# ---------------------------------------------------------------------------
# Node 22 — pinned by package.json "engines": { "node": "22.x" } (CI uses Node 22).
# The orb base image ships a newer system Node, so install 22 into /usr/local,
# replacing the `node`/`npm`/`npx` symlinks. Skipped when a v22 node is already live.
NODE_VERSION="22.23.4"
NODE_PREFIX="/usr/local/lib/nodejs"
NODE_DIR="$NODE_PREFIX/node-v$NODE_VERSION-linux-x64"

if node -v 2>/dev/null | grep -q "^v22\."; then
  step "node $(node -v) already active, skipping Node install"
else
  step "installing Node v$NODE_VERSION (system node is $(node -v 2>/dev/null || echo missing))"
  curl -fsSL "https://nodejs.org/dist/v$NODE_VERSION/node-v$NODE_VERSION-linux-x64.tar.xz" -o /tmp/node.tar.xz
  sudo mkdir -p "$NODE_PREFIX"
  sudo tar -xJf /tmp/node.tar.xz -C "$NODE_PREFIX"
  rm -f /tmp/node.tar.xz
  for bin in node npm npx; do
    sudo ln -sf "$NODE_DIR/bin/$bin" "/usr/local/bin/$bin"
  done
  step "installed Node $(node -v)"
fi

# ---------------------------------------------------------------------------
# Dependencies — npm ci when node_modules is absent or package-lock.json changed.
# Marker lives inside node_modules so a stale snapshot restores it alongside the install.
LOCK_HASH=$(sha256sum package-lock.json | cut -d' ' -f1)
STAMP="node_modules/.npm-ci-stamp"
if [[ -f "$STAMP" && "$(cat "$STAMP")" == "$LOCK_HASH" ]]; then
  step "node_modules matches package-lock.json, skipping npm ci"
else
  step "running npm ci (node_modules missing or lockfile changed)"
  npm ci --no-audit --no-fund
  echo "$LOCK_HASH" > "$STAMP"
  step "npm ci complete"
fi

# ---------------------------------------------------------------------------
# Next.js route/typegen — CI runs `npx next typegen` before typecheck; the generated
# .next/types are not committed, so generate them here for a working fresh orb.
step "generating Next.js types (next typegen)"
npx --no-install next typegen

# ---------------------------------------------------------------------------
# Local env — tests/typecheck need no secrets, but `npm run dev` does.
# Copy the template without clobbering an existing file.
if [[ ! -f .env.local ]]; then
  cp -- .env.local.example .env.local
  step "created .env.local from .env.local.example (fill in Supabase/Resend/Upstash keys)"
else
  step ".env.local already present, leaving it untouched"
fi

step "setup done in $(( $(date +%s) - step_start ))s"
